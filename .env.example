# 뉴스 수집(선택, 둘 중 한 쌍): 네이버 클라우드 NAVER API HUB 또는 네이버 개발자센터의 뉴스 검색 API
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
